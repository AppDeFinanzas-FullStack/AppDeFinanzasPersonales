{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "vitest run --config vitest.config.ts --project unit --project http",
    "test:integration": "vitest run --config vitest.config.ts --project integration"
  },
  "dependencies": {
    "@finanzas/contracts": "workspace:*",
    "@finanzas/db": "workspace:*",
    "@finanzas/domain": "workspace:*",
    "archiver": "8.0.0",
    "better-auth": "1.7.10",
    "decimal.js": "10.6.0",
    "express": "5.3.0",
    "uuidv7": "1.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@finanzas/config": "workspace:*",
    "@types/archiver": "8.0.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
